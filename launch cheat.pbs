#!/bin/bash
#----------------------------------------------------------
# Job name
#PBS -N lipkin_cav
# queue select
#PBS -q workq
#PBS -l select=1:ncpus=1:mpiprocs=1:host=kuhpccn2
#PBS -l place=excl
# Name of stdout output file (default)
#PBS -o lipkin_cav.out 
# stdout output file
#PBS -j oe
#PBS -l walltime=120:00:00 
#----------------------------------------------------------

CHEAT_HOST="kuhpccn4"
export PYTHONWARNINGS="ignore::SyntaxWarning"
# PBS_NCPUS is not guaranteed to be set by all schedulers.
# Derive it from PBS_NODEFILE, which lists one entry per allocated CPU slot.
export PBS_NCPUS=32
export OMP_NUM_THREADS=1      # let Python multiprocessing own the cores
export CONDA_ENV=hpc
export PYFILE=$PBS_O_WORKDIR/Codes/lipkin_cavity_popstd.py
export LOGFILE="wrapper_$(date +%Y%m%d_%H%M%S).log"
#Load basic OHPC tools
module load ohpc
set -euo pipefail
#Start time
start=`date +%s.%N`
echo '---------------------------------------------'
echo "Starting cheat run with -n ${PBS_NCPUS} cores on host $CHEAT_HOST"
echo "PBS_NCPUS = ${PBS_NCPUS}"
echo '---------------------------------------------'
cd "$PBS_O_WORKDIR"

# 2. Pass variables and run the remote commands
ssh $CHEAT_HOST "export PBS_O_WORKDIR='$PBS_O_WORKDIR' PYTHONWARNINGS='$PYTHONWARNINGS' PBS_NCPUS='$PBS_NCPUS' OMP_NUM_THREADS='$OMP_NUM_THREADS' CONDA_ENV='$CONDA_ENV' PYFILE='$PYFILE' LOGFILE='$LOGFILE'; bash -s" << 'EOF' 2>&1 | tee -a "$LOGFILE"
  cd "$PBS_O_WORKDIR"
  source "$(conda info --base)/etc/profile.d/conda.sh" || exit 1
  conda activate "$CONDA_ENV" || exit 1
  python "$PYFILE" || exit 1
EOF

# 5. Capture the actual remote execution status
SSH_EXIT_CODE=$?

if [ $SSH_EXIT_CODE -ne 0 ]; then
    echo "Remote commands failed with exit code $SSH_EXIT_CODE" >&2
    exit $SSH_EXIT_CODE
fi

#End time
end=`date +%s.%N`

echo "NUM_CPUS= ${PBS_NCPUS}"
RUNTIME=$( echo "$end - $start" | bc -l )

echo '---------------------------------------------'
echo "Runtime: "$RUNTIME" sec"
echo '---------------------------------------------'

# Define login node
LOGIN_NODE="kuhpchn"

# Define the ntfy.sh URL
NTFY_URL="https://ntfy.sh/kuhpchn"

# Define the message payload
MESSAGE="Job '$PBS_JOBID' finished on kuhpchn in '$RUNTIME' secs. Check output @ '$PBS_O_WORKDIR'"

# SSH into the login node and execute the curl command remotely
sshpass -f $HOME/.password ssh "$LOGIN_NODE" "curl -X POST -d \"$MESSAGE\" \"$NTFY_URL\""
